# Copy to .env and fill in. .env is gitignored — never commit real keys.
# The eval runners auto-load .env (src/core/env.py).

# --- LLM-as-judge (Step 5). Set ONE; Gemini is the preferred cross-family judge. ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# RELAYOPS_JUDGE_PROVIDER=gemini         # force a provider (gemini|anthropic)
# RELAYOPS_JUDGE_MODEL=gemini-2.5-flash  # override the judge model

# --- Fine-tuned classifier (Step 4). Local dir/zip or a Hugging Face repo id. ---
# RELAYOPS_INTENT_MODEL=venkatamanideep/relayops-intent-qwen

# --- Dense RAG arm (optional). Without this, the offline TF-IDF arm is used. ---
# VOYAGE_API_KEY=
