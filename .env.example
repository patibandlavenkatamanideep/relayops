# Copy to .env and fill in. .env is gitignored — never commit real keys.
# The eval runners auto-load .env (src/core/env.py).

# --- LLM-as-judge (Step 5). Set ONE; Gemini is the preferred cross-family judge. ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# RELAYOPS_JUDGE_PROVIDER=gemini         # force a provider (gemini|anthropic)
# RELAYOPS_JUDGE_MODEL=gemini-2.5-flash  # judge model (Gemini default; thinking auto-disabled)
# RELAYOPS_JUDGE_DELAY=13                 # seconds between judge calls (free tier ~5/min)
# RELAYOPS_JUDGE_TIMEOUT_MS=30000         # fail provider calls instead of hanging forever

# --- Fine-tuned classifier (Step 4). Local dir/zip or a Hugging Face repo id. ---
# RELAYOPS_INTENT_MODEL=venkatamanideep/relayops-intent-qwen

# --- Dense RAG arm (optional). Without this, the offline TF-IDF arm is used. ---
# VOYAGE_API_KEY=

# --- Reply composer. template (default, offline) or llm (frontier model drafts,
#     guardrail still vets). The LLM arm is DOUBLE-GATED: it runs only when
#     RELAYOPS_COMPOSER=llm AND RELAYOPS_ALLOW_LLM=true AND ANTHROPIC_API_KEY is
#     set. RELAYOPS_ALLOW_LLM defaults to false, so a public deploy can't spend a
#     key by accident — keep hosted envs on template / allow=false.
#
#     LOCAL (private, to draft with a real model and capture a demo/GIF):
#       RELAYOPS_COMPOSER=llm
#       RELAYOPS_ALLOW_LLM=true
#       ANTHROPIC_API_KEY=your_real_key
#     PUBLIC (Railway etc.): RELAYOPS_COMPOSER=template, RELAYOPS_ALLOW_LLM=false,
#       and do NOT set ANTHROPIC_API_KEY.
# RELAYOPS_COMPOSER=llm
# RELAYOPS_ALLOW_LLM=true
# RELAYOPS_COMPOSER_MODEL=claude-opus-4-8   # e.g. claude-haiku-4-5 for a cheaper arm

# --- Datastores ---------------------------------------------------------------
# Durable SQLite stores. Both default to a sensible location; override to relocate
# or make the customer/auth data durable across restarts.
# RELAYOPS_AUDIT_DB=var/relayops_audit.sqlite3   # per-turn audit trail
# RELAYOPS_CUSTOMER_DB=:memory:                  # customer/auth/device store;
#     defaults to in-memory (re-seeded per process). Set a path for a durable
#     store that seeds once and survives the process.

# --- API auth + rate limiting (v2.1) ------------------------------------------
# Signed bearer tokens (HS256) and a per-caller turn-endpoint rate limit. Set a
# real secret in any shared environment — the default is insecure on purpose.
# RELAYOPS_JWT_SECRET=change-me-to-a-long-random-string
# RELAYOPS_JWT_TTL=3600        # bearer-token lifetime, seconds
# RELAYOPS_RATE_LIMIT=60       # max /v1/turn requests per window, per caller
# RELAYOPS_RATE_WINDOW=60      # rate-limit window, seconds
